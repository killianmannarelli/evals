# Heavy / ephemeral / secret — never commit
# local LLM-verdict reuse cache (raw audit text; rebuilds on next run)
cache/
qa_inputs/
raw/
*.zip
__pycache__/
*.pyc
.env
creds/
sa.json
# fetched fresh every run
spec.md
# runs/ IS committed (durable per-run results), but not its bulky inputs:
runs/**/qa_inputs/
runs/**/raw/
runs/**/task_dirs/
runs/**/ctx/
runs/**/batch/
runs/**/*.log
runs/**/foundation.json
