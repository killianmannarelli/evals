# Heavy / ephemeral / secret — never commit
cache/             # local LLM-verdict reuse cache (raw audit text; rebuilds on next run)
qa_inputs/
raw/
*.zip
__pycache__/
*.pyc
.env
creds/
sa.json
spec.md            # fetched fresh every run
# runs/ IS committed (durable per-run results), but not its bulky inputs:
runs/**/qa_inputs/
runs/**/raw/
runs/**/task_dirs/
runs/**/ctx/
runs/**/batch/
runs/**/*.log
runs/**/foundation.json
